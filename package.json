{
  "name": "beagle-classroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:qa": "dotenv -e .env.local -- tsx scripts/run-isolated-server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "test": "vitest run tests/unit",
    "test:integration": "dotenv -e .env.local -- tsx scripts/run-isolated-tests.ts integration",
    "test:integration:ci": "tsx scripts/run-isolated-tests.ts integration",
    "test:all": "dotenv -e .env.local -- tsx scripts/run-isolated-tests.ts all",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "dotenv -e .env.local -- tsx scripts/run-isolated-tests.ts e2e",
    "test:smoke": "dotenv -e .env.local -- tsx scripts/run-isolated-tests.ts smoke",
    "qa:safe": "tsx scripts/qa-safe-smoke.ts",
    "push:vapid:generate": "tsx scripts/generate-vapid-keys.ts",
    "db:raw-sql:apply": "dotenv -e .env.local -- tsx scripts/apply-raw-sql.ts",
    "db:raw-sql:apply:ci": "tsx scripts/apply-raw-sql.ts",
    "qa:release:dependencies": "tsx scripts/identity-course-dependency-gate.ts",
    "qa:release:dependencies:strict": "tsx scripts/identity-course-dependency-gate.ts --strict",
    "qa:release:dependencies:identity:strict": "tsx scripts/identity-course-dependency-gate.ts --strict --scope=identity",
    "qa:release:dependencies:academic:strict": "tsx scripts/identity-course-dependency-gate.ts --strict --scope=academic",
    "qa:release:dependencies:baseline": "tsx scripts/identity-course-dependency-gate.ts --write-baseline",
    "qa:migration-baseline:verify": "dotenv -e .env.local -- tsx scripts/verify-migration-baseline.ts candidate",
    "qa:migration-baseline:verify:ci": "tsx scripts/verify-migration-baseline.ts candidate",
    "qa:migration-baseline:rehearse": "dotenv -e .env.local -- tsx scripts/rehearse-migration-baseline.ts",
    "qa:migration-baseline:rehearse:ci": "tsx scripts/rehearse-migration-baseline.ts",
    "db:migration-baseline:clone:preflight": "dotenv -e .env.local -- tsx scripts/rehearse-migration-baseline-clone.ts preflight",
    "db:migration-baseline:clone:rehearse": "dotenv -e .env.local -- tsx scripts/rehearse-migration-baseline-clone.ts rehearse",
    "db:migration-baseline:qa:preflight": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts preflight",
    "db:migration-baseline:qa:adopt": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts adopt",
    "db:migration-baseline:qa:status": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts status",
    "db:migration-baseline:qa:deploy": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts deploy",
    "db:migration-baseline:qa:rollback": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts rollback",
    "db:migration-baseline:production:preflight": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts preflight --target=production",
    "db:migration-baseline:production:adopt": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts adopt --target=production",
    "db:migration-baseline:production:status": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts status --target=production",
    "db:migration-baseline:production:deploy": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts deploy --target=production",
    "db:migration-baseline:production:rollback": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts rollback --target=production",
    "qa:migration-history:prove-gap": "dotenv -e .env.local -- tsx scripts/verify-migration-baseline.ts current-history",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:migrate:qa:status": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts status",
    "db:migrate:qa:deploy": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts deploy",
    "db:migrate:production:status": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts status --target=production",
    "db:migrate:production:deploy": "dotenv -e .env.local -- tsx scripts/adopt-migration-baseline-qa.ts deploy --target=production",
    "db:migrate:qa:verify-account-status": "dotenv -e .env.local -- tsx scripts/verify-account-status-backfill.ts",
    "db:migrate:qa:verify-identity-foundation": "dotenv -e .env.local -- tsx scripts/verify-identity-foundation.ts",
    "db:identity-compatibility:qa:preflight": "dotenv -e .env.local -- tsx scripts/identity-compatibility-preflight.ts",
    "db:academic-compatibility:qa:preflight": "dotenv -e .env.local -- tsx scripts/academic-compatibility-preflight.ts",
    "db:academic-compatibility:qa:verify": "dotenv -e .env.local -- tsx scripts/verify-academic-compatibility-removal.ts",
    "db:identity-d1:qa:export": "dotenv -e .env.local -- tsx scripts/identity-d1-qa-drill.ts export",
    "db:identity-d1:qa:reset": "dotenv -e .env.local -- tsx scripts/identity-d1-qa-drill.ts reset --confirm=D1_QA_RESET",
    "db:identity-d1:qa:verify": "dotenv -e .env.local -- tsx scripts/identity-d1-qa-drill.ts verify",
    "db:single-admin:qa:preflight": "dotenv -e .env.local -- tsx scripts/reset-to-single-admin.ts qa preflight",
    "db:single-admin:qa:reset": "dotenv -e .env.local -- tsx scripts/reset-to-single-admin.ts qa reset --confirm=RESET_QA_TO_SINGLE_ADMIN",
    "db:single-admin:qa:verify": "dotenv -e .env.local -- tsx scripts/reset-to-single-admin.ts qa verify",
    "db:single-admin:production:preflight": "dotenv -e .env.local -- tsx scripts/reset-to-single-admin.ts production preflight",
    "db:single-admin:production:reset": "dotenv -e .env.local -- tsx scripts/reset-to-single-admin.ts production reset --confirm=RESET_PRODUCTION_TO_SINGLE_ADMIN",
    "db:single-admin:production:verify": "dotenv -e .env.local -- tsx scripts/reset-to-single-admin.ts production verify",
    "db:migrate:production:d0-d1": "dotenv -e .env.local -- tsx scripts/run-guarded-production-prisma.ts --confirm=APPLY_PRODUCTION_MIGRATIONS_20260729",
    "db:migrate:qa:verify-lesson-foundation": "dotenv -e .env.local -- tsx scripts/verify-lesson-workspace-foundation.ts",
    "db:lesson-backfill:qa:dry-run": "dotenv -e .env.local -- tsx scripts/plan-lesson-backfill.ts",
    "db:anonymize:qa:dry-run": "dotenv -e .env.local -- tsx scripts/anonymize-expired-deletions.ts",
    "db:anonymize:qa:apply": "dotenv -e .env.local -- tsx scripts/anonymize-expired-deletions.ts --apply",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:bootstrap": "dotenv -e .env.local -- tsx prisma/bootstrap.ts",
    "db:reset-admin": "dotenv -e .env.local -- tsx prisma/reset-to-admin.ts",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1061.0",
    "@aws-sdk/s3-request-presigner": "^3.1061.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.69.0",
    "bcryptjs": "^3.0.3",
    "file-type": "^22.0.1",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.4",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "papaparse": "^5.5.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.0.1",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,md,json}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}
